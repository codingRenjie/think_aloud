# ========== 文件位置 ==========
# 推荐：Think_Aloud/server/.env
# 也可：Think_Aloud/.env
# 不要留「OPENAI_API_KEY=」这种空行，否则会覆盖其它文件里的密钥。

# ========== API Key（只保留一行，填真实值）==========
# 任选其一：
OPENAI_API_KEY=sk-请换成你的密钥
# MOONSHOT_API_KEY=sk-请换成你的密钥

OPENAI_BASE_URL=https://api.moonshot.cn/v1
OPENAI_MODEL=kimi-k2.5
# Moonshot 部分模型仅允许 temperature=1；访问 moonshot.cn / moonshot.ai 时服务端会自动用 1，一般无需填写。
# OPENAI_TEMPERATURE=1

# 速度：对话只带最近 N 条消息（默认 20）
# MAX_CHAT_MESSAGES=16
# 每条回复最多生成 token（默认 280）
# OPENAI_MAX_TOKENS=240
# 胶囊步骤的上限（默认 1200）
# OPENAI_MAX_TOKENS_CAPSULES=1200
# 流式输出 true/false（默认 true，首字更快；若 API 不支持可改为 false）
# OPENAI_CHAT_STREAM=true
#
# 若界面长时间只有「正在组织语言」：可能是带 thinking 的模型只在后期才输出 content；
# 可换用平台标注的 faster / non-thinking 模型，或设 OPENAI_CHAT_STREAM=false 走整包返回。

# PORT=8787
