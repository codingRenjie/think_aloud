{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "pwa-node",
      "request": "launch",
      "name": "Debug: Server (Express)",
      "program": "${workspaceFolder}/server/index.js",
      "cwd": "${workspaceFolder}/server",
      "console": "internalConsole",
      "internalConsoleOptions": "openOnSessionStart",
      "skipFiles": ["<node_internals>/**"],
      "outputCapture": "std"
    },
    {
      "type": "pwa-node",
      "request": "launch",
      "name": "Debug: Server — 集成终端",
      "program": "${workspaceFolder}/server/index.js",
      "cwd": "${workspaceFolder}/server",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "outputCapture": "std"
    },
    {
      "type": "pwa-node",
      "request": "attach",
      "name": "Debug: Attach to Server (9229)",
      "port": 9229,
      "skipFiles": ["<node_internals>/**"],
      "localRoot": "${workspaceFolder}/server",
      "remoteRoot": "${workspaceFolder}/server"
    },
    {
      "type": "pwa-chrome",
      "request": "launch",
      "name": "Debug: Client（Chrome，会先起 Vite）",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/client",
      "preLaunchTask": "client: Vite dev"
    },
    {
      "type": "pwa-chrome",
      "request": "launch",
      "name": "Debug: Client — Chrome（Vite 已在终端运行）",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/client"
    }
  ],
  "compounds": [
    {
      "name": "Debug: Full stack",
      "configurations": [
        "Debug: Server (Express)",
        "Debug: Client — Chrome（Vite 已在终端运行）"
      ],
      "preLaunchTask": "client: Vite dev",
      "stopAll": true
    }
  ]
}
